HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# HTTPS 反向代理部署时设为 1
COOKIE_SECURE=0
# 仅当反向代理不保留Host时，填精确的外部来源，逗号分隔
ALLOWED_ORIGINS=
# 默认直连，不信任任何转发头。Cloudflare Tunnel只信任本机cloudflared的实际来源：
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
TRUSTED_PROXIES=
# Cloudflare使用CF-Connecting-IP；其他覆盖/清理X-Forwarded-For的可信代理可显式改为x-forwarded-for。
CLIENT_IP_HEADER=cf-connecting-ip
