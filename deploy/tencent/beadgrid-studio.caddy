http://127.0.0.1:18081 {
	bind 127.0.0.1
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:18871 {
			header_up X-Forwarded-For {remote_host}
			header_up -CF-Connecting-IP
		}
	}
	handle /assets/* {
		root * /srv/apps/beadgrid-studio/current/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/apps/beadgrid-studio/current/dist
		header Cache-Control no-store
		try_files {path} /index.html
		file_server
	}
	log {
		output file /var/log/caddy/beadgrid-studio-access.log {
			roll_size 5MiB
			roll_keep 3
			roll_keep_for 168h
		}
	}
}

pindou.shizibandu.icu {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
